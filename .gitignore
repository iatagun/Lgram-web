# .gitignore for PythonAnywhere Deployment
# Optimize project size for upload limits

# Large data files (reduce project size for PythonAnywhere)

!requirements*.txt
!*.md
!Procfile

# Data directories
data/
datasets/

# Database files (will be created on server)
db.sqlite3
*.db
*.sqlite
*.sqlite3

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
env/
venv/
ENV/
env.bak/
venv.bak/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
*.log
logs/

# Environment variables
.env
.env.local
.env.production

# Static files (will be collected on server)
staticfiles/
media/

# Development files
test_*.py
*_test.py
tests/
coverage/
.coverage
.pytest_cache/

# Documentation (optional for production)
docs/
README.md